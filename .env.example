# LeashPay Environment Variables
# Copy this to .env.local and fill in your actual values

# ── LLM Configuration ──
# Using Google Gemini free tier (no Anthropic API costs)
# Get your key from: https://aistudio.google.com/app/apikey
LLM_MODEL=gemini-3.1-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# ── Channel3 API ──
# Product search and catalog integration
# Sign up at: https://trychannel3.com
# 1,000 free searches per month
CHANNEL3_API_KEY=your_channel3_api_key_here

# ── PayPal Sandbox ──
# Get credentials from: https://developer.paypal.com/dashboard/applications/sandbox
# Create a REST API app and copy the credentials
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# ── Application Settings ──
# Base URL for PayPal redirects and webhooks
# Development: http://localhost:3000
# Production: https://your-app.onrender.com
APP_BASE_URL=http://localhost:3000

# ── Database ──
# SQLite by default (file-based, no setup needed)
# For production Postgres on Render, use: postgresql://user:pass@host:port/db
DATABASE_URL=./leashpay.db

# ── Signing Keys (Optional) ──
# Ed25519 keys for mandate signing
# If not set, ephemeral keys are generated on startup (dev only)
# To generate permanent keys, run: node scripts/generate-keys.js
# SIGNING_PRIVATE_KEY=base64_encoded_pem_here
# SIGNING_PUBLIC_KEY=base64_encoded_pem_here

# ── Development Flags ──
# Enable mock PayPal mode (no real API calls)
# PAYPAL_MOCK_MODE=true

# Enable verbose logging
# DEBUG=leashpay:*
